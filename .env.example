# Database (Neon di produksi, Postgres lokal saat pengembangan)
DATABASE_URL=postgres://user@localhost:5432/segar_anugerah_v2

# Rahasia sesi. Buat dengan: openssl rand -hex 32
SESSION_SECRET=

# Midtrans — kunci sandbox dari dashboard (Settings > Access Keys)
MIDTRANS_SERVER_KEY=
# Signature Secret Key dipakai memverifikasi tanda tangan webhook
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Cloudflare R2 (foto produk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Akun admin pertama (dipakai scripts/seed.ts)
SEED_ADMIN_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
